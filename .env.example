# ShortPilot keys — one copy per channel: channels/<name>/.env
# (`python autopilot.py new-channel <name>` creates it). Never commit or share a .env file.
# Everything is optional except what a feature needs; `python autopilot.py check` shows what is missing.
# Step-by-step for every key: docs/SETUP.md

# --- Telegram: approvals and notifications (needed for `serve` and cloud mode) ---
# 1) Telegram -> @BotFather -> /newbot -> copy the token   2) send "hi" to your bot   3) python autopilot.py telegram-setup
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Script writer: Claude Code CLI (default; uses your Claude subscription login, no API key) ---
# Only set this if `claude` is not on PATH, e.g. C:\Users\you\AppData\Roaming\npm\claude.cmd
CLAUDE_BIN=

# --- Optional writers / fallbacks (channel.json -> llm) ---
# Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Claude API (pay as you go): https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- YouTube ---
# API key (free) for "trending" topic scouting: Google Cloud -> enable YouTube Data API v3 -> Credentials -> API key
YOUTUBE_API_KEY=
# OAuth "Desktop app" client JSON for auto-upload; then run `youtube-auth` and `youtube-test` once (docs/SETUP.md)
YOUTUBE_CLIENT_SECRET_FILE=

# --- Instagram Reels auto-publish (Instagram API with Instagram Login) ---
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_TOKEN_REFRESHED=
IG_API_VERSION=v23.0
# Instagram downloads the video from a public URL. Hosts are tried in order until one works:
#   auto (default) = azure (only if AZURE_BLOB_CONTAINER_SAS_URL is set) -> tunnel -> tmpfiles -> uguu -> litterbox
#   tunnel = this PC serves the file through a free Cloudflare Quick Tunnel (cloudflared is downloaded once)
#   or your own order, e.g. PUBLIC_HOST=tunnel,tmpfiles        Test it:  python autopilot.py host-test
PUBLIC_HOST=auto
# CLOUDFLARED=/path/to/cloudflared   (optional; found or downloaded automatically)
LITTERBOX_EXPIRY=1h
# Optional, most reliable: an Azure Storage container SAS URL (permissions r,w,d,c)
AZURE_BLOB_CONTAINER_SAS_URL=

# --- Facebook Page Reels (optional): Page id + a Page access token from the same Meta app ---
FB_PAGE_ID=
FB_PAGE_TOKEN=

# --- Visuals: AI images + real stock footage behind the graphics (all free tiers) ---
# Cloudflare Workers AI (FLUX images): dash.cloudflare.com -> Account ID; API token from the "Workers AI" template
CF_ACCOUNT_ID=
CF_API_TOKEN=
# Stock videos/photos: Pixabay (free key at pixabay.com/api/docs after login). Pexels optional.
PIXABAY_API_KEY=
PEXELS_API_KEY=
# POLLINATIONS=0 turns off the no-key AI image fallback · MEDIA=off renders without photos/footage
POLLINATIONS=1
MEDIA=auto

# --- Cloud mode (filled in by: python autopilot.py cloud-setup) ---
CLAUDE_CODE_OAUTH_TOKEN=
GH_PAT=
TG_WEBHOOK_SECRET=
WORKER_URL=

# --- Cloud voices (optional; channel.json voice.tts) ---
# Azure AI Speech: 400+ voices in 140+ languages, free F0 tier
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
# Sarvam (Indian languages, prepaid credits): dashboard.sarvam.ai -> API keys
SARVAM_API_KEY=

# --- Paths (optional) ---
FFMPEG=ffmpeg
